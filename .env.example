# Gandi SFTP deployment credentials
# Copy this file to .env and fill in real values. .env is gitignored.

GANDI_SFTP_HOST=sftp.gandi.net
GANDI_SFTP_PORT=22
GANDI_SFTP_USER=your-gandi-user
GANDI_SFTP_PASS=your-gandi-password
# Remote directory where the site should be uploaded
# e.g. /lamp0/web/vhosts/martinbahier.fr/htdocs
GANDI_SFTP_REMOTE_PATH=/path/to/htdocs
