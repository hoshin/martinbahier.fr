---
import { type Lang, useTranslations } from '../i18n/ui';
import { cv } from '../data/cv';
import InlineMarkdown from './InlineMarkdown.astro';
import Tournament from './Tournament.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const data = cv[lang];
const topExperiences = data.experience.slice(0, 3);
---
<section id="cv" class="scroll-mt-20 bg-slate-50 py-20 dark:bg-slate-900/40">
  <div class="container-wide">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <h2 class="section-title section-title-engineer">{t('cv.title')}</h2>
        <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">{data.headline}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href={`/${lang}/cv`}
          class="inline-flex items-center gap-2 rounded-md bg-engineer-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-engineer-700"
        >
          {t('cv.fullPage')}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <ol class="mt-10 space-y-6">
      {topExperiences.map((exp) => (
        <li class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="flex items-center gap-2 text-lg font-bold">
              {exp.logoUrl && (
                <img
                  src={exp.logoUrl}
                  alt={`${exp.company} logo`}
                  loading="lazy"
                  decoding="async"
                  class:list={[
                    'h-6 w-6 shrink-0 self-center rounded object-contain p-0.5 ring-1 ring-slate-200 dark:ring-slate-700',
                    !exp.logoBG && 'bg-white',
                  ]}
                  style={exp.logoBG ? `background-color: ${exp.logoBG}` : undefined}
                />
              )}
              <span>
                {exp.role} <span class="font-medium text-slate-500">· {exp.company}</span>
              </span>
            </h3>
            <span class="font-mono text-sm text-slate-500">{exp.start} — {exp.end}</span>
          </div>
          {exp.location && (
            <p class="mt-1 text-sm text-slate-500">{exp.location}</p>
          )}
          {exp.summary && (
            <p class="mt-3 text-slate-700 dark:text-slate-300"><InlineMarkdown text={exp.summary} /></p>
          )}
          {exp.bullets.length > 0 && (
            <ul class="mt-3 list-disc space-y-1 pl-5 text-slate-700 dark:text-slate-300">
              {exp.bullets.map((b) => <li><InlineMarkdown text={b} /></li>)}
            </ul>
          )}
        </li>
      ))}
    </ol>

    {data.tournaments && data.tournaments.length > 0 && (
      <div class="mt-12">
        <h3 class="section-title-caster text-xl font-bold">{t('cv.tournaments')}</h3>
        <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5">
          {data.tournaments.map((tn) => (
            <li><Tournament item={tn} /></li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
