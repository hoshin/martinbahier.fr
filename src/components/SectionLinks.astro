---
import { Icon } from 'astro-icon/components';
import { type Lang, useTranslations } from '../i18n/ui';
import { proSocials, casterSocials, featuredPro, featuredCaster } from '../data/socials';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const otherPro = proSocials.filter((s) => !s.featured);
const otherCaster = casterSocials.filter((s) => !s.featured);
---
<section id="links" class="scroll-mt-20 bg-slate-50 py-20 dark:bg-slate-900/40">
  <div class="container-wide">
    <h2 class="section-title">{t('links.title')}</h2>
    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">{t('links.subtitle')}</p>

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <!-- ── PRO ─────────────────────────────────────────────── -->
      <div>
        <h3 class="section-title-engineer text-xl font-bold">
          {t('links.proHeading')}
        </h3>

        <a
          href={featuredPro.href}
          target={featuredPro.href.startsWith('http') ? '_blank' : undefined}
          rel={featuredPro.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="mt-6 block rounded-2xl border border-engineer-200 bg-gradient-to-br from-engineer-500 to-engineer-800 p-6 text-white shadow-lg transition hover:shadow-xl"
        >
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-engineer-100">
                {t('links.githubKicker')}
              </p>
              <h4 class="mt-1 text-xl font-extrabold tracking-tight sm:text-2xl">{featuredPro.label}</h4>
              <p class="mt-2 max-w-md text-sm text-engineer-50">{t('links.githubDesc')}</p>
            </div>
            <Icon name={featuredPro.icon} class="h-9 w-9 text-engineer-100" />
          </div>
        </a>

        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {otherPro.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="group flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 transition hover:border-engineer-400 hover:shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:hover:border-engineer-500"
              >
                <Icon name={s.icon} class="h-5 w-5 text-slate-500 group-hover:text-engineer-600 dark:group-hover:text-engineer-400" />
                <span class="font-semibold">{s.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- ── CASTER ──────────────────────────────────────────── -->
      <div>
        <h3 class="section-title-caster text-xl font-bold">
          {t('links.casterHeading')}
        </h3>

        <a
          href={featuredCaster.href}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 block rounded-2xl border border-caster-200 bg-gradient-to-br from-caster-500 to-caster-700 p-6 text-white shadow-lg transition hover:shadow-xl"
        >
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-caster-100">
                {t('links.hoshinKicker')}
              </p>
              <h4 class="mt-1 text-xl font-extrabold tracking-tight sm:text-2xl">{featuredCaster.label}</h4>
              <p class="mt-2 max-w-md text-sm text-caster-50">{t('links.hoshinDesc')}</p>
            </div>
            <Icon name={featuredCaster.icon} class="h-9 w-9 text-caster-100" />
          </div>
        </a>

        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {otherCaster.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="group flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 transition hover:border-caster-400 hover:shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:hover:border-caster-500"
              >
                <Icon name={s.icon} class="h-5 w-5 text-slate-500 group-hover:text-caster-600 dark:group-hover:text-caster-400" />
                <span class="font-semibold">{s.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
