---
import { type Lang, useTranslations } from '../i18n/ui';
import { bio } from '../data/bio';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const content = bio[lang];
---
<section id="about" class="scroll-mt-20 py-20">
  <div class="container-wide">
    <h2 class="section-title">{t('about.title')}</h2>
    <p class="mt-4 max-w-3xl text-lg text-slate-600 dark:text-slate-300">{content.lead}</p>

    <div class="mt-10 grid gap-8 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h3 class="section-title-engineer text-xl font-bold">
          {t('about.engineerHeading')}
        </h3>
        <div class="mt-4 space-y-4 text-slate-700 dark:text-slate-300">
          {content.engineer.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h3 class="section-title-caster text-xl font-bold">
          {t('about.casterHeading')}
        </h3>
        <div class="mt-4 space-y-4 text-slate-700 dark:text-slate-300">
          {content.caster.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>

    <ul class="mt-8 flex flex-wrap gap-3">
      {content.facts.map((f) => (
        <li class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-900">
          <span class="font-semibold text-slate-500 dark:text-slate-400">{f.label}:</span>
          <span class="text-slate-800 dark:text-slate-200">{f.value}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
