---
import { type Lang, useTranslations } from '../i18n/ui';
import { socials } from '../data/socials';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer class="mt-16 border-t border-slate-200 bg-slate-50 py-10 dark:border-slate-800 dark:bg-slate-900">
  <div class="container-wide flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="text-sm text-slate-600 dark:text-slate-400">
      <p>© {year} Martin Bahier. {t('footer.rights')}</p>
      <p class="mt-1">{t('footer.builtWith')}</p>
    </div>
    <ul class="flex flex-wrap items-center gap-4 text-sm">
      {socials.map((s) => (
        <li>
          <a
            href={s.href}
            target={s.href.startsWith('http') ? '_blank' : undefined}
            rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="text-slate-600 hover:text-engineer-700 dark:text-slate-300 dark:hover:text-engineer-300"
          >
            {s.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
