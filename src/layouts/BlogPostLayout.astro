---
import BaseLayout from './BaseLayout.astro';
import { type Lang, useTranslations } from '../i18n/ui';
import { formatDate, readingTime } from '../lib/date';

export interface Props {
  lang: Lang;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  rawContent: string;
  alternatePath?: string;
}

const { lang, title, description, pubDate, updatedDate, tags, rawContent, alternatePath } = Astro.props;
const t = useTranslations(lang);
const minutes = readingTime(rawContent);
---
<BaseLayout
  lang={lang}
  title={`${title} — Martin Bahier`}
  description={description}
  alternatePath={alternatePath}
>
  <article class="container-prose py-16">
    <a
      href={`/${lang}/blog`}
      class="font-mono text-sm text-engineer-700 hover:text-engineer-900 dark:text-engineer-300"
    >
      {t('blog.backToList')}
    </a>
    <header class="mt-6 border-b border-slate-200 pb-6 dark:border-slate-800">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-slate-600 dark:text-slate-300">{description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-slate-500">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} {t('blog.minRead')}</span>
        {tags && tags.length > 0 && (
          <>
            <span aria-hidden="true">·</span>
            <ul class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium dark:bg-slate-800">
                  #{tag}
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </header>
    <div class="prose-custom mt-8">
      <slot />
    </div>
  </article>
</BaseLayout>
