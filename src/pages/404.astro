---
/**
 * Bilingual 404 page. Lives at the root (not under /fr or /en) because the
 * incoming request that triggered the 404 may target any path, and we don't
 * want to guess the user's locale at that point. CloudFront is configured
 * to map both 403 and 404 origin responses to /404.html with status 404.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

// We render the page with the default locale wrapper, but show both languages
// in the body content so either audience finds a way back home.
const lang = 'fr' as const;
---
<BaseLayout
  lang={lang}
  title="404 — Martin Bahier"
  description="Page not found · Page introuvable"
  noindex={true}
>
  <section class="container-prose flex min-h-[60vh] flex-col items-center justify-center py-16 text-center">
    <p class="font-mono text-sm uppercase tracking-widest text-engineer-700 dark:text-engineer-400">
      404
    </p>

    <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl">
      Page introuvable
      <span class="block text-slate-500 dark:text-slate-400">Page not found</span>
    </h1>

    <p class="mt-6 max-w-xl text-slate-600 dark:text-slate-300">
      Cette page n'existe pas ou a été déplacée.
      <span class="block">This page does not exist or has been moved.</span>
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/fr"
        class="inline-flex items-center gap-2 rounded-md bg-engineer-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-engineer-700"
      >
        Retour à l'accueil
      </a>
      <a
        href="/en"
        class="inline-flex items-center gap-2 rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-800 transition hover:border-engineer-400 hover:text-engineer-700 dark:border-slate-700 dark:text-slate-200 dark:hover:border-engineer-500 dark:hover:text-engineer-300"
      >
        Back to homepage
      </a>
    </div>
  </section>
</BaseLayout>
