---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSplit from '../../components/HeroSplit.astro';
import SectionAbout from '../../components/SectionAbout.astro';
import SectionCV from '../../components/SectionCV.astro';
import SectionBlog from '../../components/SectionBlog.astro';
import SectionLinks from '../../components/SectionLinks.astro';

const lang = 'en' as const;
---
<BaseLayout
  lang={lang}
  title="Martin Bahier — Senior Software Engineer & Overwatch Caster"
  description="Personal website of Martin Bahier — Senior Software Engineer in Paris and Overwatch caster on the French-speaking scene."
  alternatePath="/fr"
>
  <HeroSplit lang={lang} />
  <SectionAbout lang={lang} />
  <SectionCV lang={lang} />
  <SectionBlog lang={lang} />
  <SectionLinks lang={lang} />
</BaseLayout>
