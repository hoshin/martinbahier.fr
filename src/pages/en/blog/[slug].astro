---
import { getCollection } from 'astro:content';
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import { postSlug } from '../../../lib/date';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'en' && !data.draft);
  return posts.map((post) => ({
    params: { slug: postSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const baseSlug = postSlug(post.id);
const frPosts = await getCollection('blog', ({ data }) => data.lang === 'fr' && !data.draft);
const frMatch = frPosts.find((p) => postSlug(p.id) === baseSlug);
const alternatePath = frMatch
  ? `/fr/blog/${postSlug(frMatch.id)}`
  : '/fr/blog';
---
<BlogPostLayout
  lang="en"
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  rawContent={post.body ?? ''}
  alternatePath={alternatePath}
>
  <Content />
</BlogPostLayout>
